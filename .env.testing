APP_NAME=KoriePay
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# In-memory SQLite for the test suite
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fail-closed webhook secrets (must be set explicitly in every environment)
GATEWAY_WEBHOOK_SECRET=change-me-in-real-environments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
DUSUPAY_WEBHOOK_SECRET=
SMILE_ID_API_KEY=
SMILE_ID_PARTNER_ID=
