# ───────────────────────────────────────────────────────────────────────────
# KORIEPAY — Vercel / serverless production environment
# ───────────────────────────────────────────────────────────────────────────
# Copy the values you need into Vercel → Project → Settings → Environment
# Variables. NEVER commit real values. Vercel reads these at build + runtime.
#
# The vercel.json file already injects the serverless-safe defaults
# (APP_ENV=production, cache paths under /tmp, SESSION_DRIVER=cookie,
# CACHE_STORE=array, QUEUE_CONNECTION=sync, LOG_CHANNEL=stderr).
# Add only the secrets + connectivity below.

# ── App ────────────────────────────────────────────────────────────────
APP_NAME="KoriePay"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_KEY_GENERATED_BY_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://your-project-name.vercel.app
# (comma separated, e.g. https://koriepay.com)

# ── Database (Neon Postgres) ────────────────────────────────────────────
# Local/dev uses SQLite; production MUST use Neon (or any Postgres) because
# Vercel’s filesystem is ephemeral. Prefer the POOLED host (*-pooler.*) on
# Vercel. You can paste the dashboard string as DATABASE_URL *or* split vars.
#
# Prefer the pooled host (*-pooler.*) on Vercel. sslmode=require is mandatory.
# channel_binding=require is recommended (SCRAM); Laravel forwards it via
# App\Database\NeonPostgresConnector.
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DB_URL="${DATABASE_URL}"
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.c-2.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your-db-password
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# ── Object storage (documents/report artifacts) ─────────────────────────
# Vercel filesystems are ephemeral; the document center + report artifacts
# need durable storage. Any S3-compatible bucket works (AWS S3, Cloudflare R2,
# DigitalOcean Spaces…).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=koriepay-artifacts
# Cloudflare R2 example:
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_URL=https://pub-<hash>.r2.dev
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Sessions / cache / queue (serverless-safe, set by vercel.json) ──────
# SESSION_DRIVER=cookie        (stateless; signed by APP_KEY)
# CACHE_STORE=array            (per-request only — NEVER for balances anyway)
# QUEUE_CONNECTION=sync        (background jobs run inline — see guide §7)
# LOG_CHANNEL=stderr           (surfaces in Vercel function logs)
